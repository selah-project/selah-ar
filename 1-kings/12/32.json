{"tier":"glm-5.2","verse":32,"ref":"1-kings 12:32","book":"1-kings","lang":"ar","chapter":12,"translation":"وعمل ياروفعام عيداً في الشهر الثامن في خامس عشر يوماً للشهر، كالعيد الذي في يهودا، وصعد على المذبح. هكذا فعل في بيت إيل، ليذبح للعجول التي صنعها، وأقام في بيت إيل ⟨את⟩ كوهني الباموت الذين صنعهم.","tokens":[{"surface":"ויעש","gloss":"وعمل"},{"surface":"ירבעם","gloss":"ياروفعام"},{"surface":"חג","gloss":"عيداً"},{"surface":"בחדש","gloss":"في الشهر"},{"surface":"השמיני","gloss":"الثامن"},{"surface":"בחמשה","gloss":"في خمسة"},{"surface":"עשר","gloss":"عشر"},{"surface":"יום","gloss":"يوماً"},{"surface":"לחדש","gloss":"للشهر"},{"surface":"כחג","gloss":"كالعيد"},{"surface":"אשר","gloss":"الذي"},{"surface":"ביהודה","gloss":"في يهودا"},{"surface":"ויעל","gloss":"وصعد"},{"surface":"על","gloss":"على"},{"surface":"המזבח","gloss":"المذبح"},{"surface":"כן","gloss":"هكذا"},{"surface":"עשה","gloss":"فعل"},{"surface":"בבית","gloss":"في بيت"},{"surface":"אל","gloss":"إيل"},{"surface":"לזבח","gloss":"ليذبح"},{"surface":"לעגלים","gloss":"للعجول"},{"surface":"אשר","gloss":"التي"},{"surface":"עשה","gloss":"صنعها"},{"surface":"והעמיד","gloss":"وأقام"},{"surface":"בבית","gloss":"في بيت"},{"surface":"אל","gloss":"إيل"},{"surface":"את","gloss":"⟨את⟩","marks":"كوهني الباموت"},{"surface":"כהני","gloss":"كوهني"},{"surface":"הבמות","gloss":"الباموت"},{"surface":"אשר","gloss":"الذين"},{"surface":"עשה","gloss":"صنعهم"}],"timestamp":"2026-08-07T01:48:01.412427657Z","model":"glm-5.2"}