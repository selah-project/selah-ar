{"tier":"glm-5.2","verse":10,"ref":"2-chronicles 19:10","book":"2-chronicles","lang":"ar","chapter":19,"translation":"وكلّ خصومةٍ تأتي عليكم من إخوتكم الساكنين في مدنهم، بين دمٍّ ⟨و⟩دمٍّ، وبين توراةٍ ⟨و⟩وصيّة، لفرائضَ وأحكام، تنذرونهم، فلا يأثمون ليهوه، فلا يكون سخطٌ عليكم وعلى إخوتكم. هكذا تفعلون فلا تأثمون.","tokens":[{"surface":"וכל","gloss":"وكلّ"},{"surface":"ריב","gloss":"خصومةٍ"},{"surface":"אשר","gloss":"⟨التي⟩"},{"surface":"יבוא","gloss":"تأتي"},{"surface":"עליכם","gloss":"عليكم"},{"surface":"מאחיכם","gloss":"من إخوتكم"},{"surface":"הישבים","gloss":"الساكنين"},{"surface":"בעריהם","gloss":"في مدنهم"},{"surface":"בין","gloss":"بين"},{"surface":"דם","gloss":"دمٍّ"},{"surface":"לדם","gloss":"⟨و⟩دمٍّ"},{"surface":"בין","gloss":"وبين"},{"surface":"תורה","gloss":"توراةٍ"},{"surface":"למצוה","gloss":"⟨و⟩وصيّةٍ"},{"surface":"לחקים","gloss":"لفرائضَ"},{"surface":"ולמשפטים","gloss":"وأحكامٍ"},{"surface":"והזהרתם","gloss":"تنذرون"},{"surface":"אתם","gloss":"⟨את⟩","marks":"إيّاهم"},{"surface":"ולא","gloss":"فلا"},{"surface":"יאשמו","gloss":"يأثمون"},{"surface":"ליהוה","gloss":"ليهوه"},{"surface":"והיה","gloss":"فلا يكون"},{"surface":"קצף","gloss":"سخطٌ"},{"surface":"עליכם","gloss":"عليكم"},{"surface":"ועל","gloss":"وعلى"},{"surface":"אחיכם","gloss":"إخوتكم"},{"surface":"כה","gloss":"هكذا"},{"surface":"תעשון","gloss":"تفعلون"},{"surface":"ולא","gloss":"فلا"},{"surface":"תאשמו","gloss":"تأثمون"}],"timestamp":"2026-08-07T05:27:45.645075203Z","model":"glm-5.2"}