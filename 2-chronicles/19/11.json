{"tier":"glm-5.2","verse":11,"ref":"2-chronicles 19:11","book":"2-chronicles","lang":"ar","chapter":19,"translation":"وهوذا أمرياهو الكاهنُ الرأسُ عليكم لكلِّ أمرٍ يخصّ يهوه، وزَبَدْياهو بن يِشْمَعئيل النّاجيدُ لبيت يهودا لكلِّ أمرٍ يخصّ الملك، والشُّوطريم اللاويّون أمامكم. تشدّدوا وافعلوا، وليكن يهوه مع الصالح.","tokens":[{"surface":"והנה","gloss":"وهوذا"},{"surface":"אמריהו","gloss":"أمرياهو"},{"surface":"כהן","gloss":"الكاهنُ"},{"surface":"הראש","gloss":"الرأسُ"},{"surface":"עליכם","gloss":"عليكم"},{"surface":"לכל","gloss":"لكلِّ"},{"surface":"דבר","gloss":"أمرٍ"},{"surface":"יהוה","gloss":"يهوه"},{"surface":"וזבדיהו","gloss":"وزَبَدْياهو"},{"surface":"בן","gloss":"بن"},{"surface":"ישמעאל","gloss":"يِشْمَعئيل"},{"surface":"הנגיד","gloss":"النّاجيدُ"},{"surface":"לבית","gloss":"لبيت"},{"surface":"יהודה","gloss":"يهودا"},{"surface":"לכל","gloss":"لكلِّ"},{"surface":"דבר","gloss":"أمرٍ"},{"surface":"המלך","gloss":"المَلِكِ"},{"surface":"ושטרים","gloss":"والشُّوطريم"},{"surface":"הלוים","gloss":"اللاويّون"},{"surface":"לפניכם","gloss":"أمامكم"},{"surface":"חזקו","gloss":"تشدّدوا"},{"surface":"ועשו","gloss":"وافعلوا"},{"surface":"ויהי","gloss":"وليكن"},{"surface":"יהוה","gloss":"يهوه"},{"surface":"עם","gloss":"مع"},{"surface":"הטוב","gloss":"الصالحِ"}],"timestamp":"2026-08-07T05:27:45.645234585Z","model":"glm-5.2"}