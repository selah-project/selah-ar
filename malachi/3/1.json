{"tier":"glm-5.2","verse":1,"ref":"malachi 3:1","book":"malachi","lang":"ar","chapter":3,"translation":"هأنذا أُرسل ملاكي، ⟨ف⟩يُهيّئ طريقًا أمامي. وفجأة يأتي إلى هيكله السيدُ الذي تطلبونه، وملاكُ البريت الذي تُسرّون به — هوذا يأتي، قال يهوه صَباؤوت.","tokens":[{"surface":"הנני","gloss":"هأنذا"},{"surface":"שלח","gloss":"أُرسل"},{"surface":"מלאכי","gloss":"ملاكي"},{"surface":"ופנה","gloss":"و⟨يُهيّئ⟩"},{"surface":"דרך","gloss":"طريقًا"},{"surface":"לפני","gloss":"أمامي"},{"surface":"ופתאם","gloss":"وفجأة"},{"surface":"יבוא","gloss":"يأتي"},{"surface":"אל","gloss":"إلى"},{"surface":"היכלו","gloss":"هيكله"},{"surface":"האדון","gloss":"السيد"},{"surface":"אשר","gloss":"الذي"},{"surface":"אתם","gloss":"أنتم"},{"surface":"מבקשים","gloss":"تطلبونه"},{"surface":"ומלאך","gloss":"وملاك"},{"surface":"הברית","gloss":"البريت"},{"surface":"אשר","gloss":"الذي"},{"surface":"אתם","gloss":"أنتم"},{"surface":"חפצים","gloss":"تُسرّون به"},{"surface":"הנה","gloss":"هوذا"},{"surface":"בא","gloss":"يأتي"},{"surface":"אמר","gloss":"قال"},{"surface":"יהוה","gloss":"يهوه"},{"surface":"צבאות","gloss":"صَباؤوت"}],"timestamp":"2026-08-07T03:40:56.426335219Z","model":"glm-5.2"}